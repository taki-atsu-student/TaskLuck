{
  "name": "taskluck",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "aws-amplify": "^6.18.0",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "jspdf": "^4.2.1"
  }
}
